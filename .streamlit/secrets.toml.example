# Paste a copy of this file into Streamlit Community Cloud > App settings > Secrets.
# Replace the placeholder values there. Do not commit a file named secrets.toml.
#
# Cloud mode deliberately uses Groq for planning and Gemini for review. Local Ollama
# remains available in your private .env using MODEL_ROUTING=parallel-ensemble.

MODEL_ROUTING = "groq-gemini"
GROQ_MODEL = "openai/gpt-oss-120b"
GEMINI_MODEL = "gemini-3.5-flash-lite"

GROQ_API_KEY = "replace-with-your-groq-key"
GEMINI_API_KEY = "replace-with-your-gemini-key"
