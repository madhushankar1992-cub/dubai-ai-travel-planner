# Environment variables are read directly; .env is not loaded automatically.
# The CLI can load a private file with --env-file .env without changing PowerShell.
DATA_MODE=local-only
DATASET_PATH=data/curated/dubai-seed.json
DATABASE_PATH=runtime/catalog.sqlite
# No model account is required in Phases 0–2.
LLM_PROVIDER=
LLM_MODEL=
# Groq runs every agent except Review; Gemini runs Review.
# Never commit actual keys.
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash-lite
MODEL_ROUTING=groq-gemini
MODEL_OUTPUT_TOKENS=1024
RUN_TIMEOUT_SECONDS=300
MODEL_TIMEOUT_SECONDS=90
PROVIDER_TIMEOUT_SECONDS=10
MAX_REVISIONS=2
MAX_MODEL_CALLS=40
MAX_MODEL_TOKENS=80000
MAX_PROVIDER_CALLS=40
